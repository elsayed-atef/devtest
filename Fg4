# Servers to check
$servers = @("Server1", "Server2", "Server3")  # Add all your server names here
$configFile = "D:\path\to\config.json"  # Define the path to your config file
$logFile = "D:\data\temp\OnboardingCheck.log"

# Load Configuration
if (-Not (Test-Path $configFile)) {
    Write-Host "Configuration file not found at $configFile. Exiting." -ForegroundColor Red
    exit
}
$config = Get-Content -Path $configFile | ConvertFrom-Json

# Function to check if a software is installed and get its version
function Get-SoftwareVersion {
    param ($SoftwareName)

    $paths = @(
        "HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*",
        "HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*"
    )

    foreach ($path in $paths) {
        $software = Get-ItemProperty -Path $path -ErrorAction SilentlyContinue |
                    Where-Object { $_.DisplayName -like "*$SoftwareName*" }
        if ($software) {
            return $software.DisplayVersion
        }
    }
    return $null
}

# Function to check registry key value
function Check-RegistryKey {
    param ($Path, $Name, $ExpectedValue)
    try {
        $value = Get-ItemProperty -Path $Path -Name $Name -ErrorAction Stop
        if ($value.$Name -eq $ExpectedValue) {
            return $true
        }
    }
    catch {
        return $false
    }
    return $false
}

# Function to Log Information
function Write-Log {
    param ($Message)
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    Add-Content -Path $logFile -Value "[$timestamp] $Message"
}

# Main Execution Loop
foreach ($server in $servers) {
    Write-Log "Checking $server"

    Invoke-Command -ComputerName $server -ScriptBlock {
        param ($config, $logFile)

        # Function Definitions for Remote Execution
        function Get-SoftwareVersion {
            param ($SoftwareName)

            $paths = @(
                "HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*",
                "HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*"
            )

            foreach ($path in $paths) {
                $software = Get-ItemProperty -Path $path -ErrorAction SilentlyContinue |
                            Where-Object { $_.DisplayName -like "*$SoftwareName*" }
                if ($software) {
                    return $software.DisplayVersion
                }
            }
            return $null
        }

        function Check-RegistryKey {
            param ($Path, $Name, $ExpectedValue)
            try {
                $value = Get-ItemProperty -Path $Path -Name $Name -ErrorAction Stop
                if ($value.$Name -eq $ExpectedValue) {
                    return $true
                }
            }
            catch {
                return $false
            }
            return $false
        }

        function Write-Log {
            param ($Message)
            $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
            Add-Content -Path $logFile -Value "[$timestamp] $Message"
        }

        # Check each software installation and version
        foreach ($software in $config.Software) {
            $installedVersion = Get-SoftwareVersion -SoftwareName $software.Name

            if ($installedVersion) {
                $status = "Installed (Version: $installedVersion)"
                
                # Check for version mismatch
                if ($software.ExpectedVersion -and $installedVersion -ne $software.ExpectedVersion) {
                    $status += " - Mismatch (Expected: $($software.ExpectedVersion))"
                }
            } else {
                $status = "Not Installed"
            }

            Write-Log "$($software.Name) - $status"
        }

        # Check each registry entry
        foreach ($reg in $config.Registry) {
            $isCorrect = Check-RegistryKey -Path $reg.Path -Name $reg.Name -ExpectedValue $reg.Value
            $status = if ($isCorrect) { "Correct" } else { "Incorrect or Missing" }
            Write-Log "$($reg.Path)\$($reg.Name) - $status"
        }

    } -ArgumentList $config, $logFile
}

Write-Log "Checks completed. Log file is located at $logFile"
Write-Host "Checks completed. Check the log at $logFile"
